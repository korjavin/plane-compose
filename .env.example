# ===========================================
# Plane Configuration
# ===========================================

# --- Docker Images ---
# Pin to specific digest for reproducibility, e.g., ghcr.io/OWNER/plane-vendor@sha256:...
SERVICE_IMAGE=ghcr.io/korjavin/plane-vendor:latest

# --- Container Names ---
SERVICE_CONTAINER_NAME=plane

# --- Network Names ---
TRAEFIK_NETWORK_NAME=traefik_default
INTERNAL_NETWORK_NAME=plane_internal

# --- Traefik Configuration ---
SERVICE_HOST=plane.yourdomain.com
TRAEFIK_CERTRESOLVER=myresolver

# --- Passwords & Secrets ---
# Generate these securely (e.g., using `openssl rand -hex 32`)
SECRET_KEY=change-me
POSTGRES_PASSWORD=change-me
MINIO_ROOT_PASSWORD=change-me
RABBITMQ_PASSWORD=change-me

# --- App Settings ---
# DOMAIN_NAME in Plane's configuration corresponds to the hostname it serves
# This is usually the same as SERVICE_HOST, e.g., plane.yourdomain.com

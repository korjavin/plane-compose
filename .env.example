# ===========================================
# Plane Configuration
# ===========================================

# --- Docker Images ---
# Pin to specific digest for reproducibility, e.g., ghcr.io/OWNER/plane-vendor@sha256:...
SERVICE_IMAGE=ghcr.io/korjavin/plane-vendor:latest

# --- Container Names ---
SERVICE_CONTAINER_NAME=plane

# --- Network Names ---
TRAEFIK_NETWORK_NAME=traefik_default
INTERNAL_NETWORK_NAME=plane_internal

# --- Traefik Configuration ---
SERVICE_HOST=plane.yourdomain.com
TRAEFIK_CERTRESOLVER=myresolver

# --- Passwords & Secrets ---
# Generate these securely (e.g., using `openssl rand -hex 32`)
SECRET_KEY=change-me
POSTGRES_PASSWORD=change-me
RABBITMQ_PASSWORD=change-me

# --- Storage Configuration (MinIO vs External S3) ---
# To use the built-in MinIO container, set COMPOSE_PROFILES=minio
# If using external S3/R2, leave COMPOSE_PROFILES empty and set:
# USE_MINIO=0
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_S3_BUCKET_NAME=plane-uploads
# AWS_S3_ENDPOINT_URL=https://your-endpoint.com

# If using internal MinIO, just set this (used for AWS_SECRET_ACCESS_KEY):
AWS_SECRET_ACCESS_KEY=change-me-minio-root-password
MINIO_ROOT_PASSWORD=${AWS_SECRET_ACCESS_KEY}

# --- App Settings ---
# DOMAIN_NAME in Plane's configuration corresponds to the hostname it serves
# This is usually the same as SERVICE_HOST, e.g., plane.yourdomain.com
